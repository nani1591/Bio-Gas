# Option A (recommended): backend endpoint that accepts JSON POST requests.
# Example: VITE_CONTACT_API_URL=https://your-domain.example/api/contact
VITE_CONTACT_API_URL=

# Option B (simple fallback): opens the visitor's email app with the enquiry drafted.
